# MySQL Database Configuration
DB_HOST=localhost
DB_USER=root
DB_PASS=
DB_NAME=SFM

# Flask Application Secret Key
SECRET_KEY=sfm_super_secret_jwt_and_session_key_2026

# Google Gemini AI Configuration
GEMINI_API=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Pinecone Vector Database Configuration
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=finance-manager

# Mail Configuration (Brevo SMTP / Flask-Mail)
# Get your credentials from: https://app.brevo.com/settings/keys/smtp
MAIL_SERVER=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USE_TLS=True
MAIL_USE_SSL=False
MAIL_USERNAME=your_brevo_login_email@example.com
MAIL_PASSWORD=your_brevo_smtp_key
MAIL_DEFAULT_SENDER=your_verified_sender@example.com

